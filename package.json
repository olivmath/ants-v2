{
  "name": "ants-v2-monorepo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm contracts:build",
    "contracts:build": "pnpm --filter contracts build",
    "contracts:test": "pnpm --filter contracts test",
    "contracts:coverage": "pnpm --filter contracts coverage",
    "contracts:lint": "pnpm --filter contracts lint",
    "contracts:format": "pnpm --filter contracts format",
    "indexer:dev": "pnpm --filter indexer dev",
    "indexer:codegen": "pnpm --filter indexer codegen",
    "dapp:dev": "pnpm --filter dapp dev",
    "dapp:build": "pnpm --filter dapp build",
    "dev": "pnpm --parallel --filter dapp --filter indexer dev",
    "dev:all": "./scripts/dev.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "test:e2e": "./scripts/test-e2e.sh"
  }
}
